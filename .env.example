# Scholarly acquisition
OPENALEX_API_KEY=replace_me
CROSSREF_MAILTO=you@example.org

# Embeddings / semantic ranking
OPENAI_API_KEY=replace_me
NEUROFEED_EMBEDDING_MODEL=text-embedding-3-small
NEUROFEED_EMBEDDING_DIMENSIONS=1536

# Server-side global ingestion/ranking. Never expose or commit the real secret key.
SUPABASE_URL=https://yajsdhpaobqtduazpkkd.supabase.co
SUPABASE_SECRET_KEY=replace_me

# Newsletter generation
NEUROFEED_SUMMARY_MODEL=gpt-5.6-luna
NEUROFEED_SUMMARY_REASONING_EFFORT=xhigh
# Use the free Vercel deployment URL during the pilot; a custom domain is not required.
NEUROFEED_PUBLIC_URL=https://your-neurofeed-project.vercel.app

# Newsletter delivery. Gmail is the pilot default, but these settings are SMTP-provider neutral.
NEUROFEED_SMTP_HOST=smtp.gmail.com
NEUROFEED_SMTP_PORT=587
NEUROFEED_SMTP_USERNAME=neurofeed.example@gmail.com
# For Gmail, use an app password rather than committing your account password.
NEUROFEED_SMTP_PASSWORD=replace_me
NEUROFEED_EMAIL_FROM=Neurofeed <neurofeed.example@gmail.com>
